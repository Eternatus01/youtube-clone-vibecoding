# ---- Secrets (install.sh generates random values if missing) ----
POSTGRES_USER=yt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=yt
JWT_SECRET=change_me
REFRESH_SECRET=change_me
S3_ACCESS_KEY=admin
S3_SECRET_KEY=dev_secret_key

# ---- App ----
DATABASE_URL=postgresql+asyncpg://yt:change_me@db:5432/yt
S3_ENDPOINT=seaweedfs:8333
S3_BUCKET=videos
S3_REGION=us-east-1
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost
UPLOAD_MAX_SIZE=524288000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO