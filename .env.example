# ---- Secrets (install.sh generates random values if missing) ----
POSTGRES_USER=yt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=yt
JWT_SECRET=change_me
REFRESH_SECRET=change_me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio

# ---- App ----
DATABASE_URL=postgresql+asyncpg://yt:change_me@db:5432/yt
MINIO_ENDPOINT=s3:8000
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_BUCKET=videos
MINIO_USE_SSL=false
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost
UPLOAD_MAX_SIZE=524288000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
LOG_LEVEL=INFO