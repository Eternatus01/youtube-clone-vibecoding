{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "small_model": "tooken/deepseek-v4-pro",
  "compaction": { "auto": true, "prune": true },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "codesearch": "deny",
    "todowrite": "deny",
    "context7_*": "deny",
    "jcodemunch_*": "deny",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm -rf*": "ask",
      "docker compose down -v*": "deny",
      "docker compose down --volumes*": "deny",
      "docker volume rm*": "deny",
      "docker volume prune*": "deny",
      "docker system prune*": "deny"
    }
  }
}